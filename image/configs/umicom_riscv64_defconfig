BR2_riscv=y
BR2_RISCV_64=y
# Umicom OS Foundation: diskless, static, no guest network or login shell.
# Kernel package hashes are supplied by the pinned Buildroot release.
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_GCC_VERSION_14_X=y
BR2_STATIC_LIBS=y
BR2_KERNEL_HEADERS_AS_KERNEL=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_12=y
BR2_REPRODUCIBLE=y
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y
BR2_INIT_NONE=y
BR2_SYSTEM_BIN_SH_NONE=y
# BR2_PACKAGE_BUSYBOX is not set
# BR2_TARGET_GENERIC_GETTY is not set
BR2_TARGET_GENERIC_HOSTNAME="umicom"
BR2_TARGET_GENERIC_ISSUE="Umicom OS Foundation"
BR2_TARGET_GENERIC_ROOT_PASSWD="!"
BR2_PACKAGE_UMICOM_OS_INIT=y
BR2_PACKAGE_UMICOM_FRAMEWORK_PROBE=y
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.12.109"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_UMICOM_OS_PATH)/../kernel/foundation.config"
# BR2_TARGET_ROOTFS_TAR is not set
BR2_LINUX_KERNEL_USE_ARCH_DEFAULT_CONFIG=y
