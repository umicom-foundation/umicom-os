# Assert command outcomes as well as text; a fixture cannot claim a guest boot.
if(NOT DEFINED PROGRAM OR NOT DEFINED PLAN_CASE OR NOT DEFINED FIXTURES)
    message(FATAL_ERROR "The plan check requires a program, case and fixtures")
endif()
set(_config "${FIXTURES}/ordered.conf")
set(_args)
set(_expected 1)
if(PLAN_CASE STREQUAL "ordered")
    set(_expected 0)
elseif(PLAN_CASE STREQUAL "recovery")
    set(_expected 0)
    list(APPEND _args --cmdline "umicom.recovery=1")
elseif(PLAN_CASE STREQUAL "cycle" OR PLAN_CASE STREQUAL "unsafe-path")
    set(_config "${FIXTURES}/${PLAN_CASE}.conf")
elseif(PLAN_CASE STREQUAL "duplicate-option")
    list(APPEND _args --cmdline "umicom.recovery=1 umicom.recovery=0")
elseif(PLAN_CASE STREQUAL "missing")
    set(_config "${FIXTURES}/does-not-exist.conf")
elseif(PLAN_CASE STREQUAL "unknown-argument")
    list(APPEND _args --not-supported value)
    set(_expected 2)
else()
    message(FATAL_ERROR "Unknown plan case")
endif()
execute_process(COMMAND "${PROGRAM}" "${_config}" ${_args}
    RESULT_VARIABLE _result OUTPUT_VARIABLE _out ERROR_VARIABLE _err TIMEOUT 10)
if(NOT "${_result}" STREQUAL "${_expected}")
    message(FATAL_ERROR "Expected exit ${_expected}, got ${_result}\n${_out}\n${_err}")
endif()
string(REPLACE "\r\n" "\n" _out "${_out}")
if(PLAN_CASE STREQUAL "ordered")
    set(_text "UMICOM_OS_PLAN 1\nhostname=umicom\nmode=normal\nconfigured=2\nscheduled=2\nservice=platform-check|/usr/libexec/umicom-platform-check|-|1000\nservice=framework-probe|/usr/libexec/umicom-framework-probe|platform-check|5000\nexecuted=false\n")
    if(NOT _out STREQUAL _text)
        message(FATAL_ERROR "Unexpected dependency order or execution claim:\n${_out}")
    endif()
elseif(PLAN_CASE STREQUAL "recovery")
    set(_text "UMICOM_OS_PLAN 1\nhostname=umicom\nmode=recovery\nconfigured=2\nscheduled=0\nexecuted=false\n")
    if(NOT _out STREQUAL _text)
        message(FATAL_ERROR "Recovery must not schedule ordinary services:\n${_out}")
    endif()
elseif(NOT _out STREQUAL "")
    message(FATAL_ERROR "A rejected plan must not emit an accepted plan:\n${_out}")
endif()
