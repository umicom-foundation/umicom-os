# LICENCE: MIT
#-----------------------------------------------------------------------------
cmake_minimum_required(VERSION 3.24)
if(NOT DEFINED PROGRAM OR NOT DEFINED PLAN_CASE OR NOT DEFINED FIXTURES)
    message(FATAL_ERROR "Program, plan case and fixture directory are required")
endif()
set(_config "${FIXTURES}/ordered.conf")
set(_args --json)
set(_expected 0)
set(_recovery FALSE)
if(PLAN_CASE STREQUAL "normal")
elseif(PLAN_CASE STREQUAL "recovery")
    list(APPEND _args --cmdline "umicom.recovery=1")
    set(_recovery TRUE)
elseif(PLAN_CASE STREQUAL "option-order")
    set(_args --cmdline "umicom.recovery=1" --json)
    set(_recovery TRUE)
elseif(PLAN_CASE STREQUAL "poweroff")
    list(APPEND _args --cmdline "umicom.autopoweroff=1")
elseif(PLAN_CASE STREQUAL "cycle" OR PLAN_CASE STREQUAL "unsafe-path")
    set(_config "${FIXTURES}/${PLAN_CASE}.conf")
    set(_expected 1)
elseif(PLAN_CASE STREQUAL "duplicate-json")
    list(APPEND _args --json)
    set(_expected 2)
elseif(PLAN_CASE STREQUAL "duplicate-cmdline")
    list(APPEND _args --cmdline "umicom.recovery=1" --cmdline "umicom.recovery=0")
    set(_expected 2)
elseif(PLAN_CASE STREQUAL "missing-value")
    list(APPEND _args --cmdline)
    set(_expected 2)
elseif(PLAN_CASE STREQUAL "option-as-value")
    set(_args --cmdline --json)
    set(_expected 2)
elseif(PLAN_CASE STREQUAL "unknown")
    list(APPEND _args --execute)
    set(_expected 2)
elseif(PLAN_CASE STREQUAL "invalid-controls")
    list(APPEND _args --cmdline "umicom.recovery=1 umicom.recovery=0")
    set(_expected 1)
else()
    message(FATAL_ERROR "Unknown JSON plan case: ${PLAN_CASE}")
endif()
execute_process(COMMAND "${PROGRAM}" "${_config}" ${_args}
    RESULT_VARIABLE _result OUTPUT_VARIABLE _out ERROR_VARIABLE _err TIMEOUT 10)
if(NOT "${_result}" STREQUAL "${_expected}")
    message(FATAL_ERROR "Expected exit ${_expected}, got ${_result}\n${_out}\n${_err}")
endif()
if(NOT _expected EQUAL 0)
    if(NOT _out STREQUAL "" OR _err STREQUAL "")
        message(FATAL_ERROR "Rejection must report a diagnostic without an accepted plan")
    endif()
    return()
endif()
if(NOT _err STREQUAL "")
    message(FATAL_ERROR "Successful inspection reported an error: ${_err}")
endif()
string(JSON _schema GET "${_out}" schema)
string(JSON _version GET "${_out}" version)
string(JSON _hostname GET "${_out}" hostname)
string(JSON _configured GET "${_out}" configured)
string(JSON _scheduled GET "${_out}" scheduled)
string(JSON _mode GET "${_out}" mode)
string(JSON _executed GET "${_out}" executed)
string(JSON _executed_type TYPE "${_out}" executed)
string(JSON _poweroff GET "${_out}" autopoweroff)
string(JSON _count LENGTH "${_out}" services)
if(NOT _schema STREQUAL "umicom.os.boot-plan" OR NOT _version EQUAL 1 OR
   NOT _hostname STREQUAL "umicom" OR NOT _configured EQUAL 2 OR
   _executed OR NOT _executed_type STREQUAL "BOOLEAN")
    message(FATAL_ERROR "Invalid plan identity or execution claim: ${_out}")
endif()
if(PLAN_CASE STREQUAL "poweroff")
    if(NOT _poweroff)
        message(FATAL_ERROR "Requested poweroff control was lost")
    endif()
elseif(_poweroff)
    message(FATAL_ERROR "Poweroff was not requested")
endif()
if(_recovery)
    if(NOT _mode STREQUAL "recovery" OR NOT _scheduled EQUAL 0 OR NOT _count EQUAL 0)
        message(FATAL_ERROR "Recovery must retain configured count and schedule no services")
    endif()
else()
    if(NOT _mode STREQUAL "normal" OR NOT _scheduled EQUAL 2 OR NOT _count EQUAL 2)
        message(FATAL_ERROR "Normal plan lost scheduled services")
    endif()
    string(JSON _first GET "${_out}" services 0 id)
    string(JSON _first_path GET "${_out}" services 0 executable)
    string(JSON _first_dependency TYPE "${_out}" services 0 dependency)
    string(JSON _first_timeout GET "${_out}" services 0 timeoutMs)
    string(JSON _second GET "${_out}" services 1 id)
    string(JSON _dependency GET "${_out}" services 1 dependency)
    if(NOT _first STREQUAL "platform-check" OR
       NOT _first_path STREQUAL "/usr/libexec/umicom-platform-check" OR
       NOT _first_dependency STREQUAL "NULL" OR NOT _first_timeout EQUAL 1000 OR
       NOT _second STREQUAL "framework-probe" OR NOT _dependency STREQUAL _first)
        message(FATAL_ERROR "Structured plan changed dependency order or service values")
    endif()
endif()
