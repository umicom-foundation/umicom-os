# Run the ordinary console driver. It does not mount, reboot or start services.
if(NOT DEFINED PROGRAM OR NOT DEFINED CASE OR NOT DEFINED WORK)
    message(FATAL_ERROR "Console plan check requires PROGRAM, CASE and WORK")
endif()
if(NOT CASE STREQUAL "services" AND NOT CASE STREQUAL "empty")
    message(FATAL_ERROR "Unknown console plan case")
endif()
file(MAKE_DIRECTORY "${WORK}")
file(WRITE "${WORK}/input.txt" "services\npoweroff\n")
set(_args)
if(CASE STREQUAL "empty")
    list(APPEND _args --empty)
endif()
execute_process(COMMAND "${PROGRAM}" ${_args} INPUT_FILE "${WORK}/input.txt"
    OUTPUT_VARIABLE _out ERROR_VARIABLE _err RESULT_VARIABLE _result TIMEOUT 10)
if(NOT "${_result}" STREQUAL "0")
    message(FATAL_ERROR "Console driver failed: ${_result}\n${_out}\n${_err}")
endif()
string(FIND "${_out}" "STOP_REQUEST=1" _stop)
if(_stop LESS 0)
    message(FATAL_ERROR "The driver did not finish the requested sequence")
endif()
if(CASE STREQUAL "services")
    string(FIND "${_out}" "1. platform-check | /usr/libexec/umicom-platform-check | after=- | timeout=1000 ms" _first)
    string(FIND "${_out}" "2. framework-probe | /usr/libexec/umicom-framework-probe | after=platform-check | timeout=5000 ms" _second)
    string(FIND "${_out}" "not a record of execution" _limit)
    if(_first LESS 0 OR _second LESS _first OR _limit LESS 0)
        message(FATAL_ERROR "Service order, timeout or scope description was lost:\n${_out}")
    endif()
else()
    string(FIND "${_out}" "No accepted service configuration is available." _empty)
    string(FIND "${_out}" "1. " _invented)
    if(_empty LESS 0 OR NOT _invented LESS 0)
        message(FATAL_ERROR "The console must not invent an accepted plan:\n${_out}")
    endif()
endif()
