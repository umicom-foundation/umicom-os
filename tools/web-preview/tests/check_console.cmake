# PURPOSE: Verify native arguments and read-only command admission without starting a listener.
# AUTHOR AND ORGANISATION: Sammy Hegab / Umicom Foundation
# LICENCE: MIT
if(NOT DEFINED TOOL OR NOT DEFINED CASE)
    message(FATAL_ERROR "TOOL and CASE are required")
endif()
if(WIN32)
    set(root "C:/umicom-preview-fixture-no-root-io")
else()
    set(root "/umicom-preview-fixture-no-root-io")
endif()
set(args --root "${root}" --port 8080 --dry-run)
set(expected 0)
if(CASE STREQUAL "help")
    set(args --help)
elseif(CASE STREQUAL "unicode")
    string(APPEND root "/café with spaces")
    set(args --root "${root}" --port 8080 --dry-run)
elseif(CASE STREQUAL "relative")
    set(args --root . --port 8080 --dry-run)
    set(expected 2)
elseif(CASE STREQUAL "duplicate")
    list(APPEND args --port 8081)
    set(expected 2)
elseif(CASE STREQUAL "unknown")
    list(APPEND args --unknown)
    set(expected 2)
elseif(NOT CASE STREQUAL "dry-run")
    message(FATAL_ERROR "Unknown case")
endif()
execute_process(COMMAND "${TOOL}" ${args} RESULT_VARIABLE result
    OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 10)
if(NOT "${result}" STREQUAL "${expected}")
    message(FATAL_ERROR "Unexpected exit ${result}: ${out} ${err}")
endif()
if(expected EQUAL 0)
    if(CASE STREQUAL "help")
        if(NOT out MATCHES "1 MiB" OR NOT out MATCHES "127.0.0.1")
            message(FATAL_ERROR "Help does not describe the shared preview contract: ${out}")
        endif()
    else()
        string(FIND "${out}" "Root: ${root}" root_position)
        if(root_position LESS 0 OR NOT out MATCHES "Syntax admitted" OR NOT out MATCHES "127.0.0.1:8080")
            message(FATAL_ERROR "Plan lost argument identity: ${out}")
        endif()
    endif()
elseif(out MATCHES "Local preview:")
    message(FATAL_ERROR "Refused input entered service mode")
endif()
