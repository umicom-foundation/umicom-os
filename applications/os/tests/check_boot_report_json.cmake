if(NOT DEFINED PROGRAM OR NOT DEFINED CASE OR NOT DEFINED WORK OR NOT DEFINED AVAILABLE)
    message(FATAL_ERROR "Boot JSON check needs PROGRAM, CASE, WORK and AVAILABLE")
endif()
file(MAKE_DIRECTORY "${WORK}")
set(_before "${WORK}/earlier.report")
set(_after "${WORK}/later.report")
if(CASE STREQUAL "unicode")
    set(_before "${WORK}/rapport-été.report")
endif()
set(_source "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef")
set(_earlier "UMICOM_BOOT_REPORT 1\nmode=normal\nstate=starting\nplanned=2\ncompleted=1\nreason=none\nsource=${_source}\n")
set(_later "UMICOM_BOOT_REPORT 1\nmode=normal\nstate=ready\nplanned=2\ncompleted=2\nreason=none\nsource=${_source}\n")
set(_args --boot-report-json "${_before}")
set(_expected 0)
if(CASE STREQUAL "inspect" OR CASE STREQUAL "unicode")
elseif(CASE STREQUAL "matching")
    list(APPEND _args --source "${_source}")
elseif(CASE STREQUAL "mismatch")
    list(APPEND _args --source "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
    set(_expected 1)
elseif(CASE STREQUAL "compare" OR CASE STREQUAL "source")
    set(_args --compare-boot-reports-json "${_before}" "${_after}")
    if(CASE STREQUAL "source")
        string(REPLACE "source=0" "source=a" _later "${_later}")
    endif()
elseif(CASE STREQUAL "malformed")
    set(_earlier "invalid report\n")
    set(_expected 1)
elseif(CASE STREQUAL "missing-argument")
    set(_args --compare-boot-reports-json "${_before}")
    set(_expected 2)
elseif(CASE STREQUAL "bad-option")
    list(APPEND _args --other "${_source}")
    set(_expected 2)
else()
    message(FATAL_ERROR "Unknown boot JSON case")
endif()
if(NOT AVAILABLE AND NOT _expected EQUAL 2)
    set(_expected 1)
endif()
file(CONFIGURE OUTPUT "${_before}" CONTENT "${_earlier}" @ONLY NEWLINE_STYLE LF)
file(CONFIGURE OUTPUT "${_after}" CONTENT "${_later}" @ONLY NEWLINE_STYLE LF)
file(SHA256 "${_before}" _before_hash)
file(SHA256 "${_after}" _after_hash)
execute_process(COMMAND "${PROGRAM}" ${_args} RESULT_VARIABLE _result
    OUTPUT_VARIABLE _out ERROR_VARIABLE _err TIMEOUT 10)
if(NOT "${_result}" STREQUAL "${_expected}")
    message(FATAL_ERROR "Unexpected boot JSON exit ${_result}, expected ${_expected}\n${_out}\n${_err}")
endif()
string(FIND "${_out}${_err}" "Umicom OS user-space" _startup)
if(NOT _startup LESS 0)
    message(FATAL_ERROR "Inspection must not start the OS lifecycle")
endif()
if(_expected EQUAL 0)
    if(NOT "${_err}" STREQUAL "")
        message(FATAL_ERROR "Successful inspection wrote stderr: ${_err}")
    endif()
    string(JSON _version ERROR_VARIABLE _error GET "${_out}" schema_version)
    if(NOT _error STREQUAL "NOTFOUND" OR NOT _version STREQUAL "1")
        message(FATAL_ERROR "Expected schema_version 1 JSON: ${_out}")
    endif()
    string(JSON _scope GET "${_out}" scope)
    if(CASE STREQUAL "compare" OR CASE STREQUAL "source")
        if(NOT _scope STREQUAL "captured-boot-comparison")
            message(FATAL_ERROR "Wrong comparison scope")
        endif()
        string(JSON _same GET "${_out}" same_source)
        string(JSON _changes LENGTH "${_out}" changed_fields)
        string(JSON _first GET "${_out}" changed_fields 0)
        string(JSON _second GET "${_out}" changed_fields 1)
        if(NOT _first STREQUAL "state" OR NOT _second STREQUAL "completed")
            message(FATAL_ERROR "Changed fields did not preserve the public order")
        endif()
        if(CASE STREQUAL "source")
            string(JSON _third GET "${_out}" changed_fields 2)
            if(_same OR NOT _changes EQUAL 3 OR NOT _third STREQUAL "source")
                message(FATAL_ERROR "Different sources must be explicit")
            endif()
        elseif(NOT _same OR NOT _changes EQUAL 2)
            message(FATAL_ERROR "Same-source comparison is incorrect")
        endif()
        string(JSON _before_state GET "${_out}" before state)
        string(JSON _after_state GET "${_out}" after state)
        if(NOT _before_state STREQUAL "starting" OR NOT _after_state STREQUAL "ready")
            message(FATAL_ERROR "Snapshots were not retained in chronological argument order")
        endif()
    else()
        string(JSON _identity GET "${_out}" report source)
        string(JSON _completed GET "${_out}" report completed)
        if(NOT _scope STREQUAL "captured-boot-observation" OR NOT _identity STREQUAL _source OR NOT _completed EQUAL 1)
            message(FATAL_ERROR "Captured report fields changed")
        endif()
    endif()
elseif(_expected EQUAL 1)
    if(NOT "${_out}" STREQUAL "")
        message(FATAL_ERROR "Rejected capture must not publish partial JSON")
    endif()
    if(NOT AVAILABLE)
        string(FIND "${_err}" "Boot-report JSON is unavailable in the selected Framework" _unavailable)
        if(_unavailable LESS 0)
            message(FATAL_ERROR "Older SDK must state that the component is unavailable")
        endif()
    endif()
endif()
file(SHA256 "${_before}" _before_now)
file(SHA256 "${_after}" _after_now)
if(NOT _before_hash STREQUAL _before_now OR NOT _after_hash STREQUAL _after_now)
    message(FATAL_ERROR "JSON inspection modified captured inputs")
endif()
