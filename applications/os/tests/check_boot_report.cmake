# Umicom OS | Sammy Hegab, Umicom Foundation | MIT
# Use build-owned captured reports; this does not start PID1 or a guest.
if(NOT DEFINED PROGRAM OR NOT DEFINED CASE OR NOT DEFINED WORK)
    message(FATAL_ERROR "OS report CLI check requires PROGRAM, CASE and WORK")
endif()
file(MAKE_DIRECTORY "${WORK}")
set(_source "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef")
set(_file "${WORK}/boot.report")
if(CASE STREQUAL "unicode")
    set(_file "${WORK}/rapport-café.report")
endif()
# The report is a byte protocol emitted by Linux init. Explicit LF output keeps
# Windows text-mode conversion from turning a valid fixture into rejected CRLF.
# Retain the original writer for review; the separate CRLF case checks rejection.
if(FALSE)
    file(WRITE "${_file}" "UMICOM_BOOT_REPORT 1\nmode=normal\nstate=ready\nplanned=2\ncompleted=2\nreason=none\nsource=${_source}\n")
endif()
set(_report "UMICOM_BOOT_REPORT 1\nmode=normal\nstate=ready\nplanned=2\ncompleted=2\nreason=none\nsource=${_source}\n")
file(CONFIGURE OUTPUT "${_file}" CONTENT "${_report}" @ONLY NEWLINE_STYLE LF)
string(SHA256 _report_hash "${_report}")
file(SHA256 "${_file}" _fixture_hash)
if(NOT _report_hash STREQUAL _fixture_hash)
    message(FATAL_ERROR "Boot-report fixture bytes differ from the canonical LF report")
endif()
set(_args --boot-report "${_file}")
set(_expected 0)
set(_diagnostic "")
if(CASE STREQUAL "valid" OR CASE STREQUAL "unicode")
elseif(CASE STREQUAL "matching")
    list(APPEND _args --source "${_source}")
elseif(CASE STREQUAL "mismatch")
    list(APPEND _args --source "1123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef")
    set(_expected 1)
    # A source mismatch must reach identity comparison, not fail earlier parsing.
    set(_diagnostic "status=2)")
elseif(CASE STREQUAL "crlf")
    file(CONFIGURE OUTPUT "${_file}" CONTENT "${_report}" @ONLY NEWLINE_STYLE CRLF)
    file(READ "${_file}" _hex HEX)
    if(NOT _hex MATCHES "0d0a")
        message(FATAL_ERROR "CRLF rejection fixture has no carriage-return bytes")
    endif()
    set(_expected 1)
    set(_diagnostic "status=1)")
elseif(CASE STREQUAL "source-short")
    list(APPEND _args --source "0123")
    set(_expected 1)
    set(_diagnostic "status=1)")
elseif(CASE STREQUAL "source-uppercase")
    string(TOUPPER "${_source}" _upper)
    list(APPEND _args --source "${_upper}")
    set(_expected 1)
    set(_diagnostic "status=1)")
elseif(CASE STREQUAL "source-empty")
    # Preserve an explicit empty argument instead of allowing a CMake list to drop it.
    set(_expected 1)
    set(_diagnostic "status=1)")
elseif(CASE STREQUAL "malformed")
    file(WRITE "${_file}" "not a boot report\n")
    set(_expected 1)
elseif(CASE STREQUAL "relative")
    set(_args --boot-report relative.report)
    set(_expected 1)
elseif(CASE STREQUAL "unknown")
    set(_args --unknown)
    set(_expected 2)
elseif(CASE STREQUAL "help")
    set(_args --help)
else()
    message(FATAL_ERROR "Unknown report CLI case")
endif()
file(SHA256 "${_file}" _before)
if(CASE STREQUAL "source-empty")
    execute_process(COMMAND "${PROGRAM}" --boot-report "${_file}" --source ""
        RESULT_VARIABLE _result OUTPUT_VARIABLE _out ERROR_VARIABLE _err TIMEOUT 10)
else()
    execute_process(COMMAND "${PROGRAM}" ${_args} RESULT_VARIABLE _result
        OUTPUT_VARIABLE _out ERROR_VARIABLE _err TIMEOUT 10)
endif()
if(NOT _diagnostic STREQUAL "")
    string(FIND "${_err}" "${_diagnostic}" _diagnostic_found)
    if(_diagnostic_found LESS 0)
        message(FATAL_ERROR "Expected ${_diagnostic}; rejection was: ${_err}")
    endif()
endif()
file(SHA256 "${_file}" _after)
if(NOT _before STREQUAL _after OR NOT "${_result}" STREQUAL "${_expected}")
    message(FATAL_ERROR "Changed input or unexpected exit ${_result}; expected ${_expected}\n${_out}\n${_err}")
endif()
if(CASE STREQUAL "valid" OR CASE STREQUAL "matching" OR CASE STREQUAL "unicode")
    foreach(_text IN ITEMS "Captured boot report" "state=ready" "completed=2/2" "not proof of current machine health")
        string(FIND "${_out}" "${_text}" _found)
        if(_found LESS 0)
            message(FATAL_ERROR "Missing ${_text} in report output")
        endif()
    endforeach()
elseif(CASE STREQUAL "help")
    string(FIND "${_out}" "--boot-report ABSOLUTE_FILE" _found)
    if(_found LESS 0)
        message(FATAL_ERROR "Missing inspection help")
    endif()
else()
    string(FIND "${_out}" "Captured boot report" _invented)
    if(NOT _invented LESS 0)
        message(FATAL_ERROR "A rejected input must not be presented as an accepted report")
    endif()
endif()
